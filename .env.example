# ChamaSmart environment variables  (TEMPLATE - safe to commit)
# 1. Copy this file:  cp .env.example .env
# 2. Replace every CHANGE_ME with your real value.
# 3. NEVER commit the real .env file (it is listed in .gitignore).

# --- MySQL ---
DB_NAME=chama_app
DB_USER=chama
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME

JWT_SECRET=CHANGE_ME

# --- Play Framework ---
# Generate one with:  openssl rand -hex 32
APPLICATION_SECRET=CHANGE_ME

# --- Africa's Talking SMS (use the sandbox while developing) ---
AT_USERNAME=sandbox
AT_API_KEY=CHANGE_ME
